# === BEGIN Cloudflare-origin-lock (2026-08-24) ===
# Cloudflare IP restoration is ON, so REMOTE_ADDR is the VISITOR's IP for proxied
# traffic -- an IP allow-list would block real users. LiteSpeed also ignores
# "Require ip" in .htaccess (verified). So we key on Cloudflare's own headers,
# which are present on proxied requests and absent on direct-to-origin hits.
# NOTE: a determined attacker can forge CF-RAY. This stops mass scanners, it is
# not a cryptographic boundary -- that needs Authenticated Origin Pulls (mTLS).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:CF-RAY} ^$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ - [F,L]
</IfModule>
# === END Cloudflare-origin-lock ===

# GAkinz — Apache config for the document root.
# Routing: prerendered public pages from their own index.html, real files and
# PHP directly, and everything else to app-shell.html so React Router handles
# it in the browser (e.g. /app/leads, /verify/abc).

RewriteEngine On
RewriteBase /

# Pass the Authorization header through to PHP (cPanel/LiteSpeed strips it
# under CGI/FastCGI, which would make every bearer-token check fail with 401).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Prerendered public pages (scripts/prerender.mjs, 2026-10-16). /work and
# /work/ are both served work/index.html, internally, with no redirect, so the
# address stays the one the page's canonical names. This sits above the
# directory pass-through on purpose: there, /work would reach mod_dir and be
# redirected to /work/. The home page needs no rule: / is the document root,
# and its index.html is the prerendered home page.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# A directory with no index.html of its own (/assets/, /uploads/, /images/)
# answers 404 instead of the host's file listing, which was on and listed every
# build file (go-live audit 2026-11-01). Done here rather than with
# `Options -Indexes`, which can turn every request into a 500 on this host
# (K-058). The home page is the document root: its path is empty, so `.+`
# never matches it. Prerendered pages were served by the rule above.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^.+$ - [R=404,L]

# Let real files and directories through (assets, *.php, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Don't rewrite the PHP API endpoints
RewriteRule ^(api|contact|ai|verify)\.php$ - [L]

# A request for a .php file that does not exist answers 404 instead of falling
# through to the SPA shell. dist/ can go live before a new endpoint is uploaded,
# and an HTML 200 for a missing endpoint reads to the CMS as a broken reply; a
# 404 lets it say "not available yet" quietly (src/lib/notAvailable.ts). Real
# .php files never reach this rule (the pass-through above ends them), and the
# _*.php and config.php deny below still answers 403 for the ones that exist.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.php$ - [R=404,L]

# Everything else → the SPA shell: the CMS (/app/*), /login, /set-password,
# /p/:token, /verify/:id, a record published only in the CMS, and unknown
# paths. Not index.html, which is now the prerendered home page. Until a build
# with app-shell.html has been deployed, fall back to index.html as before, so
# this file can be uploaded before or after that deploy; the client renders
# the right page either way (src/main.tsx).
RewriteCond %{DOCUMENT_ROOT}/app-shell.html -f
RewriteRule ^ app-shell.html [L]
RewriteRule ^ index.html [L]

# Basic hardening
# Directory listing is answered 404 by the rewrite near the top. No
# `Options -Indexes` here on purpose: where the host does not allow Options
# overrides, that one line turns every request into a 500. Ask the host to
# switch off directory listing instead (K-058).

# Browser security headers on every response: the prerendered pages, the SPA
# shell and static files, not only the PHP JSON that _bootstrap.php covers.
# HSTS without includeSubDomains (a subdomain this repository does not know of
# may still need plain HTTP) and without preload; Cloudflare may send it too,
# which is harmless. No server or PHP version leaves the site (go-live 2026-11-01).
ServerSignature Off
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header always unset X-Turbo-Charged-By
  Header unset X-Turbo-Charged-By
</IfModule>

# Content-Security-Policy (K-033). Enforced on the prerendered public pages
# (each is an index.html): checked locally on all 32 pages at 390 and 1440px
# with no violation. The hash is the one inline script (the next-themes theme
# setter); `npm run build` fails if it changes and is not updated here
# (src/prerender/csp.ts). Style attributes need 'unsafe-inline'. Switching on
# ads or a consent platform (D-050) needs their hosts added here first.
# The SPA shell (CMS, sign-in, shared proposals) reports only: Clerk cannot be
# run locally, so its needs are listed but not yet enforced. Watch the browser
# console after release, then enforce.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-cd+HpnSsLaEz1lKWBNn+k+xOe1m2p5ZgfjoyNvHy9eU='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </FilesMatch>
  <FilesMatch "^app-shell\.html$">
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-cd+HpnSsLaEz1lKWBNn+k+xOe1m2p5ZgfjoyNvHy9eU=' https://clerk.gakinz.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://img.clerk.com; font-src 'self' data:; connect-src 'self' https://clerk.gakinz.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>

# Vite's content-hashed build files (/assets/<name>-<8-char hash>.js|css|woff2)
# never change under the same name, so browsers may keep them for a year. Was
# 4 hours for JS (2026-11-01 SEO audit). HTML, app-shell.html and unhashed files
# do not match and keep the host's default.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# config.php and every shared include (_bootstrap, _money, _smtp, _sms, _slack,
# _monitor and any future _*.php). Includes are required by endpoints, never
# requested directly (KNOWN-ISSUES K-013).
<FilesMatch "^(config|_[A-Za-z0-9_-]+)\.php$">
  Require all denied
</FilesMatch>

# Never serve docs, SQL, logs, plain-text notes, or deploy state from the doc
# root. `.txt` is covered because a generated seed password once landed there.
# robots.txt and llms.txt are the two plain-text files the site must serve, so
# the leading negative lookahead exempts both by name. llms.txt ships in dist/
# to this same document root and would otherwise return 403. The exemption is inside the pattern
# rather than in a later <Files "robots.txt"> allow block on purpose: one rule
# decides the outcome, with no dependence on how the server merges overlapping
# <Files>/<FilesMatch> sections. sitemap.xml is not matched by either branch
# and is served normally.
<FilesMatch "^(?!robots\.txt$|llms\.txt$).*\.(md|sql|log|txt)$|^(error_log|\.ftp-deploy-sync-state\.json|\.ftpquota)$">
  Require all denied
</FilesMatch>

# Dotfiles (.user.ini and the like), editor and backup copies, templates and any
# copy of the settings stub (config.php.bak, config.php.old). A release never
# deletes, so a stray file made by hand would otherwise stay served
# (2026-11-01 security audit). Files only: the .well-known directory is untouched.
<FilesMatch "^\.|\.(bak|old|orig|save|swp|example|dist)$|~$|^config\.php\.">
  Require all denied
</FilesMatch>
