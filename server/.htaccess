# === BEGIN Cloudflare-origin-lock (2026-08-24) ===
# Cloudflare IP restoration is ON, so REMOTE_ADDR is the VISITOR's IP for proxied
# traffic -- an IP allow-list would block real users. LiteSpeed also ignores
# "Require ip" in .htaccess (verified). So we key on Cloudflare's own headers,
# which are present on proxied requests and absent on direct-to-origin hits.
# NOTE: a determined attacker can forge CF-RAY. This stops mass scanners, it is
# not a cryptographic boundary -- that needs Authenticated Origin Pulls (mTLS).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:CF-RAY} ^$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ - [F,L]
</IfModule>
# === END Cloudflare-origin-lock ===

# GAkinz — Apache config for the document root.
# SPA routing: serve real files/PHP directly; send everything else to index.html
# so React Router handles client-side routes (e.g. /about, /services/web-design).

RewriteEngine On
RewriteBase /

# Pass the Authorization header through to PHP (cPanel/LiteSpeed strips it
# under CGI/FastCGI, which would make every bearer-token check fail with 401).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Let real files and directories through (assets, *.php, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Don't rewrite the PHP API endpoints
RewriteRule ^(api|contact|ai|verify)\.php$ - [L]

# Everything else → the SPA shell
RewriteRule ^ index.html [L]

# Basic hardening
<FilesMatch "^(config|_bootstrap)\.php$">
  Require all denied
</FilesMatch>

# Never serve docs, SQL, logs, plain-text notes, or deploy state from the doc
# root. `.txt` is covered because a generated seed password once landed there.
# robots.txt and llms.txt are the two plain-text files the site must serve, so
# the leading negative lookahead exempts both by name. llms.txt ships in dist/
# to this same document root and would otherwise return 403. The exemption is inside the pattern
# rather than in a later <Files "robots.txt"> allow block on purpose: one rule
# decides the outcome, with no dependence on how the server merges overlapping
# <Files>/<FilesMatch> sections. sitemap.xml is not matched by either branch
# and is served normally.
<FilesMatch "^(?!robots\.txt$|llms\.txt$).*\.(md|sql|log|txt)$|^(error_log|\.ftp-deploy-sync-state\.json|\.ftpquota)$">
  Require all denied
</FilesMatch>
