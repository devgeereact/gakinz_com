<?php
/**
 * GAkinz — server configuration (gakinz.com).
 *
 * COPY this file to `config.php` on the server and fill in the real values.
 * NEVER commit config.php. It is gitignored and lives only on the server.
 *
 * Used by every endpoint via _bootstrap.php. Provides:
 *   $conn (mysqli) + DB_*, OPENROUTER_*, OR_*, ALLOWED_ORIGINS constants.
 */

// ── Error display ─────────────────────────────────────────────────────────────
// Flip to true ONLY while debugging on the server. When true, PHP warnings and
// stack traces print into responses — never leave this on in production, it
// leaks file paths / SQL and corrupts JSON output. Errors are always logged.
define('GK_DEBUG', false);
ini_set('display_errors', GK_DEBUG ? '1' : '0');
ini_set('display_startup_errors', GK_DEBUG ? '1' : '0');
ini_set('log_errors', '1');
error_reporting(E_ALL);

// ── Database (cPanel / MySQL) ───────────────────────────────────────────────
// Host stays "localhost" on shared cPanel hosting. cPanel prefixes every
// database and database user with the account name, so both values take the
// form <cpanel_user>_<database>. Read the real ones from cPanel; they are not
// recorded in this repository.
define('DB_HOST', 'localhost');
define('DB_NAME', 'REPLACE_db_name');   // e.g. <cpanel_user>_<database>
define('DB_USER', 'REPLACE_db_user');   // usually the same as DB_NAME
define('DB_PASS', 'REPLACE_db_password');

// ── OpenRouter (server-side AI — read only by ai.php; never sent to the browser)
define('OPENROUTER_KEY', 'REPLACE_openrouter_key'); // sk-or-v1-…  ('' disables AI cleanly)
define('OR_MODEL', 'openai/gpt-oss-120b:free');     // model ai.php sends
define('OR_SITE', 'https://gakinz.com');            // sent as HTTP-Referer to OpenRouter

// Alternative models, swap into OR_MODEL as needed (openrouter.ai/models):
//   'google/gemma-4-31b-it:free'
//   'qwen/qwen3-next-80b-a3b-instruct:free'
//   'anthropic/claude-sonnet-4.6'

// ── CORS ─────────────────────────────────────────────────────────────────────
// In dev the Vite app runs on localhost:5102 (project block 10 in the workspace
// port scheme, ~/.claude/CLAUDE.md "Dev-server ports") and calls this live API. The dev port is pinned
// with strictPort, so this list only ever needs the one localhost entry.
// _bootstrap.php fatals without this constant — keep it defined.
define('ALLOWED_ORIGINS', [
  'https://gakinz.com',
  'https://www.gakinz.com',
  'http://localhost:5102',  // gakinz dev port — block 10, pinned in vite.config.ts
]);

// ── Optional integrations ────────────────────────────────────────────────────
define('OPENWEATHER_API_KEY', '');   // read by weather.php (CMS header widget); '' hides the widget
define('OPENWEATHER_UNITS', 'metric'); // 'metric' (°C) or 'imperial' (°F)

// ── Seed super-admin ── read by auth.php (only on an EMPTY users table) ───────
// On a fresh install auth.php creates one super-admin. Set a strong password
// here; if left blank a random one is generated and written to
// server/seed_admin_password.txt (delete that file after first login).
$SEED_ADMIN_EMAIL    = 'REPLACE_seed_admin_email';
$SEED_ADMIN_PASSWORD = '';   // '' → random, written to seed_admin_password.txt

// ── Outgoing mail (SMTP) ── read by mail.php ──────────────────────────────────
// Leave $SMTP_HOST blank to fall back to PHP mail(). Use the hosting account's
// real mail server hostname with a real mailbox + password.
// The correct hostname is a hosting fact and is NOT recorded in this repository
// (see docs/DECISIONS.md D-018). Read it from the operator's hosting notes.
// A stale hostname here fails SILENTLY: a retired host can still resolve and
// still answer on 465, so mail appears to send and never arrives.
$SMTP_HOST      = 'REPLACE_smtp_host';   // hosting account mail server, or '' for PHP mail()
$SMTP_PORT      = 465;                   // 465 = SSL, 587 = STARTTLS
$SMTP_SECURE    = 'ssl';                 // 'ssl' | 'tls' | ''  (must match the port)
$SMTP_USER      = 'hello@gakinz.com';
$SMTP_PASS      = 'REPLACE_mailbox_password'; // mailbox password (secret; never commit)
$SMTP_FROM      = 'hello@gakinz.com';
$SMTP_FROM_NAME = 'GAKINZ LTD';

// ── Incoming mail (IMAP) for the in-app inbox ── read by mail.php ─────────────
// Requires the PHP imap extension. Leave $IMAP_HOST blank to disable the inbox.
// Same hostname as $SMTP_HOST above, and the same warning applies.
$IMAP_HOST = 'REPLACE_imap_host';        // hosting account mail server, or '' to disable
$IMAP_PORT = 993;                        // 993 = IMAP over SSL
$IMAP_USER = 'hello@gakinz.com';
$IMAP_PASS = 'REPLACE_mailbox_password';

// ── Outbound SMS (Twilio) ── read by _sms.php / comms.php ─────────────────────
// Powers the "Send SMS" button on SMS conversations in Comms. Leave any blank
// to disable SMS cleanly (the button shows a "not configured" error).
$TWILIO_SID   = '';   // ACxxxxxxxx… (account SID)
$TWILIO_TOKEN = '';   // auth token (secret; never commit)
$TWILIO_FROM  = '';   // a Twilio number in E.164, e.g. '+447700900123'

// ── Stripe payments ── read by payments.php ──────────────────────────────────
// Powers invoice "Pay link" / portal "Pay". Leave $STRIPE_SECRET blank to keep
// invoicing on manual mark-as-paid. The webhook secret is from the Stripe
// dashboard endpoint you point at /payments.php?action=webhook.
$STRIPE_SECRET         = '';  // sk_live_… or sk_test_…
$STRIPE_WEBHOOK_SECRET = '';  // whsec_…
$STRIPE_SUCCESS_URL    = 'https://gakinz.com/app/invoicing?paid=1';
$STRIPE_CANCEL_URL     = 'https://gakinz.com/app/invoicing';

// ── Google SSO (oauth.php) — optional. Leave blank to hide the SSO button. ──────
// Create an OAuth 2.0 Web client in Google Cloud Console; set its redirect URI
// to GOOGLE_REDIRECT below. SSO only logs in users that ALREADY exist.
$GOOGLE_CLIENT_ID     = '';
$GOOGLE_CLIENT_SECRET = '';
$GOOGLE_REDIRECT      = 'https://gakinz.com/oauth.php?action=callback';
$APP_URL              = 'https://gakinz.com'; // SPA origin the SSO callback returns to

// ── Scheduled jobs (cron.php) — optional. ───────────────────────────────────────
// Set a long random $CRON_KEY, then add a cPanel cron entry, e.g. daily:
//   wget -qO- "https://gakinz.com/cron.php?key=YOUR_CRON_KEY&job=all"
// $REPORT_RECIPIENTS is a comma list that receives the weekly digest.
$CRON_KEY          = '';
$REPORT_RECIPIENTS = '';  // e.g. 'founder@gakinz.com, ops@gakinz.com'

// ── PayPal (payments.php) — optional. Orders API v2. ────────────────────────────
$PAYPAL_CLIENT_ID  = '';
$PAYPAL_SECRET     = '';
$PAYPAL_MODE       = 'live';  // 'sandbox' | 'live'
$PAYPAL_ENABLED    = false;   // keep false: no PayPal webhook yet, see payments.php (K-026)
// ── WhatsApp via Twilio (reuses $TWILIO_SID/$TWILIO_TOKEN). Sender in whatsapp: form.
$TWILIO_WHATSAPP_FROM = '';   // e.g. 'whatsapp:+14155238886'

// ── External connectors — all optional, each degrades until set. ────────────────
$GITHUB_TOKEN      = '';  // GitHub PAT — only needed for private repos / rate limits (public works without)
$FIGMA_TOKEN       = '';  // Figma personal access token — required for the Design Figma preview
$SLACK_WEBHOOK_URL = '';  // Slack Incoming Webhook — announcements broadcast here
$CALENDLY_URL      = '';  // e.g. 'https://calendly.com/gakinz/discovery' — discovery-call booking

// ── Retention periods (_retention.php) — owner and legal decisions. ─────────────
// docs/PRIVACY-READINESS.md section 6. null means "not decided, nothing happens":
// the retention report says "period not set" for that rule. A whole number
// changes what the report COUNTS. Only two periods can ever delete anything,
// and only through the executor below: $RETENTION_ENQUIRY_MONTHS (enquiries
// that never became a client) and $RETENTION_DELETED_FILE_DAYS (soft-deleted
// files). Every other period is report only.
//   php cron.php job=retention_report      (command line, read only)
//   php cron.php job=retention_apply       (command line, dry run: lists what would go)
//   php cron.php job=retention_apply --apply   deletes only if $RETENTION_APPLY is true
// Leave $RETENTION_APPLY false until the owner and an adviser agree the periods.
$RETENTION_APPLY               = false; // true lets job=retention_apply --apply delete by the two rules above
$RETENTION_ENQUIRY_MONTHS      = null; // enquiries that did not become a client, from last change
$RETENTION_CLIENT_MONTHS       = null; // clients with no activity on them, their projects, invoices or messages
$RETENTION_INVOICE_MONTHS      = null; // invoices and their payment events, from issue date (HMRC rules apply)
$RETENTION_AUDIT_MONTHS        = null; // audit log entries, from entry date
$RETENTION_SUPPORT_MONTHS      = null; // portal messages and feedback, from last change
$RETENTION_COMMS_MONTHS        = null; // Comms conversations and their messages, from last message
$RETENTION_STAFF_MONTHS        = null; // suspended staff accounts and their leave, from last change
$RETENTION_CERTIFICATE_MONTHS  = null; // certificates, from issue date
$RETENTION_DELETED_FILE_DAYS   = null; // soft-deleted files, from deletion (in days)

// ── Connection ────────────────────────────────────────────────────────────────
$conn = @new mysqli(DB_HOST, DB_USER, DB_PASS, DB_NAME);
if ($conn->connect_errno) {
  http_response_code(500);
  header('Content-Type: application/json');
  echo json_encode(['error' => 'Database connection failed']);
  exit;
}
$conn->set_charset('utf8mb4'); // UTF-8 so accents and emojis store correctly

// ── Legacy variable aliases ───────────────────────────────────────────────────
// Older endpoints on the server referenced these as variables; keep them in
// sync with the constants so both styles work.
$OR_API_KEY = OPENROUTER_KEY;
$OR_MODEL   = OR_MODEL;
