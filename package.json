{
  "name": "gakinz_com",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify": "node scripts/release.mjs --verify",
    "release": "node scripts/release.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run -c vitest.server.config.ts",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "check:live": "node scripts/live-check.mjs",
    "check:htaccess": "node scripts/htaccess-check.mjs",
    "check:facts": "node scripts/facts-check.mjs",
    "drill:restore": "node scripts/restore-drill.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.11",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
